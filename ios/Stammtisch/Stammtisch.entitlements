<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push über APNs. Beim Export für den App Store setzt Xcode «production» ein. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links: Einladungen und Admin-Links öffnen direkt die App -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(STAMMTISCH_HOST)</string>
	</array>
</dict>
</plist>
