# iOS-App bauen und zu TestFlight laden (GitHub Actions, .github/workflows/ios.yml).
#
# Signieren ohne Mac und ohne Zertifikatsdateien: Der private Schlüssel des Verteilungszertifikats liegt
# als Secret IOS_DIST_PRIVATE_KEY vor. Das passende Zertifikat und das App-Store-Profil holt diese Lane
# über die App Store Connect API (und legt sie beim ersten Lauf an). So entsteht nicht bei jedem Lauf
# ein neues Zertifikat, und Apple begrenzt die Zahl der Verteilungszertifikate.
require "base64"
require "openssl"
require "securerandom"
require "time"

default_platform(:ios)

BUNDLE_ID = "app.drinktracker"
PROFIL_PREFIX = "Stammtisch App Store CI"

platform :ios do
  desc "Baut die App und lädt sie zu TestFlight"
  lane :testflight_laden do
    team = ENV.fetch("IOS_TEAM_ID").strip
    version = ENV.fetch("VERSION_NAME", "1.0.0")
    build = ENV.fetch("BUILD_NUMBER")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      duration: 1200,
      in_house: false
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)

    bundle = app_id_sicherstellen
    schluessel = OpenSSL::PKey::RSA.new(ENV.fetch("IOS_DIST_PRIVATE_KEY").gsub("\\n", "\n"))
    zertifikat = zertifikat_sicherstellen(schluessel)
    profil = profil_sicherstellen(bundle, zertifikat)

    # Schlüsselbund nur für diesen Lauf
    setup_ci(force: true)
    p12_pfad = File.expand_path("verteilung.p12")
    p12_passwort = SecureRandom.hex(16)
    x509 = OpenSSL::X509::Certificate.new(Base64.decode64(zertifikat.certificate_content))
    # .p12 mit dem LibreSSL von macOS (/usr/bin/openssl): dessen Standardformat (3DES, SHA-1) liest der
    # Schlüsselbund sicher; OpenSSL 3 (auch in Ruby) schreibt AES/SHA-256, das `security import` ablehnen kann.
    key_pfad = File.expand_path("verteilung-key.pem")
    cert_pfad = File.expand_path("verteilung-cert.pem")
    File.write(key_pfad, schluessel.to_pem)
    File.write(cert_pfad, x509.to_pem)
    begin
      sh("/usr/bin/openssl", "pkcs12", "-export", "-inkey", key_pfad, "-in", cert_pfad, "-name", "Stammtisch Verteilung",
         "-out", p12_pfad, "-passout", "pass:#{p12_passwort}", log: false)
    ensure
      File.delete(key_pfad, cert_pfad)
    end
    import_certificate(
      certificate_path: p12_pfad,
      certificate_password: p12_passwort,
      keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME", "fastlane_tmp_keychain"),
      keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "")
    )
    File.delete(p12_pfad)

    profil_pfad = File.expand_path("stammtisch.mobileprovision")
    File.binwrite(profil_pfad, Base64.decode64(profil.profile_content))
    install_provisioning_profile(path: profil_pfad)

    build_app(
      project: "Stammtisch.xcodeproj",
      scheme: "Stammtisch",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Stammtisch.ipa",
      clean: true,
      xcargs: [
        "CODE_SIGN_STYLE=Manual",
        "DEVELOPMENT_TEAM=#{team}",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
        "PROVISIONING_PROFILE_SPECIFIER='#{profil.name}'",
        "MARKETING_VERSION=#{version}",
        "CURRENT_PROJECT_VERSION=#{build}"
      ].join(" "),
      export_options: {
        teamID: team,
        signingStyle: "manual",
        provisioningProfiles: { BUNDLE_ID => profil.name }
      }
    )

    if ENV["HOCHLADEN"] == "true"
      upload_to_testflight(
        api_key: api_key,
        ipa: "build/Stammtisch.ipa",
        skip_waiting_for_build_processing: true,
        changelog: ENV["CHANGELOG"].to_s.empty? ? nil : ENV["CHANGELOG"]
      )
    else
      UI.important("HOCHLADEN ist nicht true: nur gebaut, nichts hochgeladen")
    end
  end

end

# App-ID mit Push und Associated Domains registrieren (macht sonst Xcode beim ersten Öffnen)
def app_id_sicherstellen
  bundle = Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
  unless bundle
    UI.message("Registriere App-ID #{BUNDLE_ID}")
    bundle = Spaceship::ConnectAPI::BundleId.create(name: "Stammtisch", platform: "IOS", identifier: BUNDLE_ID)
  end
  vorhanden = bundle.get_capabilities.map(&:capability_type)
  [
    Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS,
    Spaceship::ConnectAPI::BundleIdCapability::Type::ASSOCIATED_DOMAINS
  ].each do |typ|
    next if vorhanden.include?(typ)
    UI.message("Schalte #{typ} für #{BUNDLE_ID} ein")
    bundle.create_capability(typ)
  end
  bundle
end

# Verteilungszertifikat zum Schlüssel aus dem Secret finden oder anlegen
def zertifikat_sicherstellen(schluessel)
  oeffentlich = schluessel.public_key.to_der
  alle = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: "DISTRIBUTION" })
  passend = alle.find do |c|
    next false if c.expiration_date && Time.parse(c.expiration_date.to_s) < Time.now
    OpenSSL::X509::Certificate.new(Base64.decode64(c.certificate_content)).public_key.to_der == oeffentlich
  rescue StandardError
    false
  end
  return passend if passend

  UI.message("Lege ein neues Apple-Distribution-Zertifikat an")
  csr = OpenSSL::X509::Request.new
  csr.version = 0
  csr.subject = OpenSSL::X509::Name.parse("/CN=Stammtisch CI/O=Stammtisch")
  csr.public_key = schluessel.public_key
  csr.sign(schluessel, OpenSSL::Digest::SHA256.new)
  Spaceship::ConnectAPI::Certificate.create(certificate_type: "DISTRIBUTION", csr_content: csr.to_pem)
end

# Gültiges App-Store-Profil für App-ID und Zertifikat finden oder anlegen. Ändern sich die Fähigkeiten
# der App-ID, wird Apple das alte Profil ungültig; dann entsteht ein neues.
def profil_sicherstellen(bundle, zertifikat)
  profile = Spaceship::ConnectAPI::Profile.all(
    filter: { profileType: "IOS_APP_STORE" },
    includes: "bundleId,certificates"
  )
  passend = profile.find do |p|
    p.name.to_s.start_with?(PROFIL_PREFIX) &&
      p.profile_state == "ACTIVE" &&
      p.bundle_id&.id == bundle.id &&
      (p.certificates || []).any? { |c| c.id == zertifikat.id }
  end
  return passend if passend

  UI.message("Lege ein neues App-Store-Profil an")
  Spaceship::ConnectAPI::Profile.create(
    name: "#{PROFIL_PREFIX} #{Time.now.utc.strftime('%Y%m%d%H%M')}",
    profile_type: "IOS_APP_STORE",
    bundle_id_id: bundle.id,
    certificate_ids: [zertifikat.id],
    device_ids: []
  )
end
